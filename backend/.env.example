# Copy to backend/.env (or set as real environment variables). No secrets belong here.
# The backend reads os.environ directly; with uvicorn you can also use:  uvicorn app.main:app --env-file .env

# SQLite file (relative to the directory you start uvicorn from; use backend/)
DATABASE_URL=sqlite:///./zynapsex.db

# Comma-separated list of frontend origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Simulator / pipeline
SAMPLE_INTERVAL_S=2.0
SIMULATOR_SEED=42
AUTOSTART_SIMULATOR=true
SCENARIO_RAMP_TICKS=15
FEATURE_WINDOW=30

# Retention of high-frequency tables (rows kept per asset)
READINGS_KEEP_PER_ASSET=3000
PREDICTIONS_KEEP_PER_ASSET=1000
PRUNE_EVERY_N_TICKS=50

# Decision support / what-if (percent of rating)
SIM_LOAD_LIMIT_PCT=100
SIM_CAUTION_PCT=90
RECOMMENDATION_COOLDOWN_TICKS=30

# Label only (shown in /api/health). Does not change behaviour or claim any IBM integration.
DEPLOYMENT_TARGET=local
